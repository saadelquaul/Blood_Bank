<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Bank Blood Management System</display-name>
    <description>MANAGING THE BLOOD DONATIONS</description>

    <servlet>
        <servlet-name>CreatePageServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.CreatePageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreatePageServlet</servlet-name>
        <url-pattern>/donor</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CreatePageServlet</servlet-name>
        <url-pattern>/receiver</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DonorListServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.DonorListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonorListServlet</servlet-name>
        <url-pattern>/donors</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceiverListServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.ReceiverListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiverListServlet</servlet-name>
        <url-pattern>/receivers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DonorActionServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.DonorActionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonorActionServlet</servlet-name>
        <url-pattern>/donors/action</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceiverActionServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.ReceiverActionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiverActionServlet</servlet-name>
        <url-pattern>/receivers/action</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AssignmentServlet</servlet-name>
        <servlet-class>org.blood_bank.controller.AssignmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignmentServlet</servlet-name>
        <url-pattern>/assignments</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
